# ─── ローカル開発用環境変数 ─────────────────────────────────
# このファイルを .env.local にコピーして使用してください。
# .env.local は .gitignore に含まれています。

# PostgreSQL 接続文字列（ローカル docker-compose）
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# ローカル開発モード（SSL無効・Cognito bypass）
IS_LOCAL=true

# Cognito（本番環境では必須。ローカルでは空のまま可）
COGNITO_USER_POOL_ID=

# ─── 本番（Supabase）用 ─────────────────────────────────────
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# IS_LOCAL=false
# COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX

# ─── 評価用ファイルの公開（Cloudflare Workers KV）────────────
# 設定の手順は cloudflare/share-worker/README.md を見てください。
# 空のままでも他の機能は動きます（公開ボタンだけが使えません）。
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
# 権限は「Workers KV Storage: 編集」だけにしたトークン。人に見せない・Gitに入れない
CF_API_TOKEN=
# 公開した評価用ファイルを見せる Worker の URL（末尾のスラッシュなし）
SHARE_BASE_URL=
