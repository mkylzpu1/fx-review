# cp terraform.tfvars.example terraform.tfvars して値を埋めること。
# terraform.tfvars は .gitignore に含めること (機密情報を含むため)。

app_name   = "your-app-name"
aws_region = "ap-northeast-1"

# PRD 用カスタムドメインを設定することを推奨。
frontend_domain_name           = "app.example.com"
cloudfront_acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx"

# bootstrap で出力された PRD 用 GitHub Actions ロール ARN を設定する。
github_actions_role_arn = "arn:aws:iam::123456789012:role/your-app-name-github-actions-deploy-prd"

# Cognito Hosted UI ドメイン (全 AWS アカウント横断でユニークである必要あり)。
cognito_domain_prefix = "your-app-name-prd-auth"

# PRD 用 Google OAuth クライアント (STG とは別のクライアントを使うこと)。
google_oauth_client_id     = "xxxxxxxxxxxx.apps.googleusercontent.com"
google_oauth_client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

monthly_budget_limit_usd = "50"
alert_notification_email = "your-email@example.com"

tags = {
  Project = "your-app-name"
}
